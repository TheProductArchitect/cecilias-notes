<?xml version="1.0" encoding="UTF-8"?>
<!--
    Info.plist for the main Ink target.

    Required Xcode setup:
    - Set this file as the target's Info.plist (Build Settings → Info.plist File).
    - The keys below are the ones Stage 10 mandates. Existing build-tool-managed
      keys (CFBundleIdentifier, CFBundleVersion etc.) should be merged in by
      Xcode at archive time.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Identity & version (Xcode auto-fills from project settings) -->
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>wave notes app</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>

    <!-- iPad/iPhone targeting comes from TARGETED_DEVICE_FAMILY in
         build settings. Don't set UIDeviceFamily here — Xcode warns and
         overwrites. -->
    <key>UIRequiresFullScreen</key>
    <false/>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Status bar -->
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleDefault</string>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <true/>

    <!-- Pencil + scribble -->
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>

    <!-- Privacy usage descriptions -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Ink records audio for your notes. Recordings are stored on your device and never uploaded.</string>

    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Ink transcribes your recordings locally on your device using Apple's speech recognition.</string>

    <key>NSPhotoLibraryUsageDescription</key>
    <string>Ink lets you insert photos from your photo library into your notes.</string>

    <key>NSCameraUsageDescription</key>
    <string>Ink lets you photograph and insert images directly into your notes.</string>

    <!-- Deep link URL scheme -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.ink.app</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>ink</string>
            </array>
        </dict>
    </array>

    <!-- Scenes -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
    </dict>

    <!-- Launch -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>InkLaunchBackground</string>
    </dict>

    <!-- Bundled custom fonts. Drop the .ttf into Resources/Fonts/ and add
         the file to the Ink target's "Copy Bundle Resources" build phase
         (or rely on the file-system synchronized group). The
         BrandWordmark / BrandIconRenderer code falls back to system bold
         if the font isn't registered. -->
    <key>UIAppFonts</key>
    <array>
        <string>Fonts/BricolageGrotesque-VariableFont_opsz,wdth,wght.ttf</string>
    </array>

    <!-- Personal Identity: alternate app icons keyed by first letter.
         The 26 icon files (Icon-a.png … Icon-z.png at every iOS-required
         pixel density) live at Resources/AppIcons/ and are produced by
         Scripts/GenerateBrandIcons.swift. iOS expects each
         CFBundleIconFiles entry to refer to a base name; suffixed
         pixel-density variants are looked up by Apple's own loader. -->
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array><string>AppIcon</string></array>
        </dict>
        <key>CFBundleAlternateIcons</key>
        <dict>
            <key>a</key><dict><key>CFBundleIconFiles</key><array><string>Icon-a</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>b</key><dict><key>CFBundleIconFiles</key><array><string>Icon-b</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>c</key><dict><key>CFBundleIconFiles</key><array><string>Icon-c</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>d</key><dict><key>CFBundleIconFiles</key><array><string>Icon-d</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>e</key><dict><key>CFBundleIconFiles</key><array><string>Icon-e</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>f</key><dict><key>CFBundleIconFiles</key><array><string>Icon-f</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>g</key><dict><key>CFBundleIconFiles</key><array><string>Icon-g</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>h</key><dict><key>CFBundleIconFiles</key><array><string>Icon-h</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>i</key><dict><key>CFBundleIconFiles</key><array><string>Icon-i</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>j</key><dict><key>CFBundleIconFiles</key><array><string>Icon-j</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>k</key><dict><key>CFBundleIconFiles</key><array><string>Icon-k</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>l</key><dict><key>CFBundleIconFiles</key><array><string>Icon-l</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>m</key><dict><key>CFBundleIconFiles</key><array><string>Icon-m</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>n</key><dict><key>CFBundleIconFiles</key><array><string>Icon-n</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>o</key><dict><key>CFBundleIconFiles</key><array><string>Icon-o</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>p</key><dict><key>CFBundleIconFiles</key><array><string>Icon-p</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>q</key><dict><key>CFBundleIconFiles</key><array><string>Icon-q</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>r</key><dict><key>CFBundleIconFiles</key><array><string>Icon-r</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>s</key><dict><key>CFBundleIconFiles</key><array><string>Icon-s</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>t</key><dict><key>CFBundleIconFiles</key><array><string>Icon-t</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>u</key><dict><key>CFBundleIconFiles</key><array><string>Icon-u</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>v</key><dict><key>CFBundleIconFiles</key><array><string>Icon-v</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>w</key><dict><key>CFBundleIconFiles</key><array><string>Icon-w</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>x</key><dict><key>CFBundleIconFiles</key><array><string>Icon-x</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>y</key><dict><key>CFBundleIconFiles</key><array><string>Icon-y</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>z</key><dict><key>CFBundleIconFiles</key><array><string>Icon-z</string></array><key>UIPrerenderedIcon</key><false/></dict>
        </dict>
    </dict>
    <key>CFBundleIcons~ipad</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array><string>AppIcon</string></array>
        </dict>
        <key>CFBundleAlternateIcons</key>
        <dict>
            <key>a</key><dict><key>CFBundleIconFiles</key><array><string>Icon-a</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>b</key><dict><key>CFBundleIconFiles</key><array><string>Icon-b</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>c</key><dict><key>CFBundleIconFiles</key><array><string>Icon-c</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>d</key><dict><key>CFBundleIconFiles</key><array><string>Icon-d</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>e</key><dict><key>CFBundleIconFiles</key><array><string>Icon-e</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>f</key><dict><key>CFBundleIconFiles</key><array><string>Icon-f</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>g</key><dict><key>CFBundleIconFiles</key><array><string>Icon-g</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>h</key><dict><key>CFBundleIconFiles</key><array><string>Icon-h</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>i</key><dict><key>CFBundleIconFiles</key><array><string>Icon-i</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>j</key><dict><key>CFBundleIconFiles</key><array><string>Icon-j</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>k</key><dict><key>CFBundleIconFiles</key><array><string>Icon-k</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>l</key><dict><key>CFBundleIconFiles</key><array><string>Icon-l</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>m</key><dict><key>CFBundleIconFiles</key><array><string>Icon-m</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>n</key><dict><key>CFBundleIconFiles</key><array><string>Icon-n</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>o</key><dict><key>CFBundleIconFiles</key><array><string>Icon-o</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>p</key><dict><key>CFBundleIconFiles</key><array><string>Icon-p</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>q</key><dict><key>CFBundleIconFiles</key><array><string>Icon-q</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>r</key><dict><key>CFBundleIconFiles</key><array><string>Icon-r</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>s</key><dict><key>CFBundleIconFiles</key><array><string>Icon-s</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>t</key><dict><key>CFBundleIconFiles</key><array><string>Icon-t</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>u</key><dict><key>CFBundleIconFiles</key><array><string>Icon-u</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>v</key><dict><key>CFBundleIconFiles</key><array><string>Icon-v</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>w</key><dict><key>CFBundleIconFiles</key><array><string>Icon-w</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>x</key><dict><key>CFBundleIconFiles</key><array><string>Icon-x</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>y</key><dict><key>CFBundleIconFiles</key><array><string>Icon-y</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>z</key><dict><key>CFBundleIconFiles</key><array><string>Icon-z</string></array><key>UIPrerenderedIcon</key><false/></dict>
        </dict>
    </dict>
</dict>
</plist>
