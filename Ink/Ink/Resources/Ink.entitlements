<?xml version="1.0" encoding="UTF-8"?>
<!--
    Ink.entitlements — main app target.

    Required Xcode setup:
    - Set this file as Code Signing Entitlements in Build Settings.
    - In Signing & Capabilities, the App Groups + iCloud capabilities must be
      added (this file alone won't enable them — Xcode also writes the
      provisioning-profile entries when you toggle the capability checkbox).
    - The InkWidget extension target needs its own .entitlements file with
      ONLY the `com.apple.security.application-groups` array (same value).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- iCloud Drive (CloudDocuments service) -->
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudDocuments</string>
    </array>
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.ink.app</string>
    </array>
    <key>com.apple.developer.ubiquity-container-identifiers</key>
    <array>
        <string>iCloud.com.ink.app</string>
    </array>

    <!-- App Group (shared with InkWidget) -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.wave.venu.Ink</string>
    </array>
</dict>
</plist>
