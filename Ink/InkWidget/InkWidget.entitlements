<?xml version="1.0" encoding="UTF-8"?>
<!--
    InkWidget.entitlements — widget extension target.
    Must match the App Group identifier in the main app's Ink.entitlements.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.wave.venu.Ink</string>
    </array>
</dict>
</plist>
