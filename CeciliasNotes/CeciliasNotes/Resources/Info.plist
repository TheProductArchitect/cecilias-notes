            <key>t</key><dict><key>CFBundleIconFiles</key><array><string>Icon-t</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>u</key><dict><key>CFBundleIconFiles</key><array><string>Icon-u</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>v</key><dict><key>CFBundleIconFiles</key><array><string>Icon-v</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>w</key><dict><key>CFBundleIconFiles</key><array><string>Icon-w</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>x</key><dict><key>CFBundleIconFiles</key><array><string>Icon-x</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>y</key><dict><key>CFBundleIconFiles</key><array><string>Icon-y</string></array><key>UIPrerenderedIcon</key><false/></dict>
            <key>z</key><dict><key>CFBundleIconFiles</key><array><string>Icon-z</string></array><key>UIPrerenderedIcon</key><false/></dict>
        </dict>
    </dict>
</dict>
</plist>
